{% extends "layout/page_without_tabs.html.twig" %}

{% set container_size = "narrow" %}

{% block content_title %}{{ __('Azure DevOps', 'azuredevops') }}{% endblock %}

{% block content_body %}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ __('Azure DevOps projects', 'azuredevops') }}</h3>
        <div class="card-actions">
            <a href="{{ new_url }}" class="btn btn-primary btn-sm"><i class="ti ti-plus"></i> {{ __('Add a project', 'azuredevops') }}</a>
        </div>
    </div>
    {% if projects is empty %}
        <div class="card-body text-muted">{{ __('No project is configured yet. Each project has its own access token and its own list of allowed users and groups.', 'azuredevops') }}</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ __('Name', 'azuredevops') }}</th>
                        <th>{{ __('Organization / project', 'azuredevops') }}</th>
                        <th>{{ __('Work item type', 'azuredevops') }}</th>
                        <th>{{ __('Authentication', 'azuredevops') }}</th>
                        <th>{{ __('Who can use it', 'azuredevops') }}</th>
                        <th>{{ __('Status', 'azuredevops') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for project in projects %}
                    <tr>
                        <td><a href="{{ project_url }}/{{ project.id }}">{{ project.name }}</a></td>
                        <td class="text-muted">{{ project.target }}</td>
                        <td>{{ project.type ?: '—' }}</td>
                        <td>{% if project.auth == 'entra' %}<span class="badge bg-purple-lt">{{ __('Entra application', 'azuredevops') }}</span>{% else %}<span class="badge bg-secondary-lt">{{ __('Personal token', 'azuredevops') }}</span>{% endif %}</td>
                        <td>
                            {% if not project.is_restricted %}
                                <span class="badge bg-blue-lt">{{ __('Every technician with the "create" right', 'azuredevops') }}</span>
                            {% elseif project.users == 0 and project.groups is empty %}
                                <span class="badge bg-orange-lt">{{ __('Nobody yet', 'azuredevops') }}</span>
                            {% else %}
                                {% for group in project.groups %}<span class="badge bg-secondary-lt me-1"><i class="ti ti-users"></i> {{ group }}</span>{% endfor %}
                                {% if project.users > 0 %}<span class="badge bg-secondary-lt"><i class="ti ti-user"></i> {{ project.users }}</span>{% endif %}
                            {% endif %}
                        </td>
                        <td>
                            {% if not project.is_active %}
                                <span class="badge bg-secondary-lt">{{ __('Inactive', 'azuredevops') }}</span>
                            {% elseif project.last_error %}
                                <span class="badge bg-red-lt">{{ __('Error', 'azuredevops') }}</span>
                                <div class="text-danger small">{{ project.last_error }}</div>
                            {% else %}
                                <span class="badge bg-green-lt">{{ __('Active', 'azuredevops') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<form method="post" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('Work item creation', 'azuredevops') }}</h3></div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">{{ __('Work item title', 'azuredevops') }}</label>
                <input type="text" name="title_template" class="form-control" value="{{ settings.title_template }}">
                <div class="form-text">{{ __('Placeholders: {id} (ticket number) and {title}.', 'azuredevops') }}</div>
            </div>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="include_people" value="1" {{ settings.include_people == '1' ? 'checked' }}><span class="form-check-label">{{ __('Mention requesters and assignees in the work item', 'azuredevops') }}</span></label>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="creation_followup" value="1" {{ settings.creation_followup == '1' ? 'checked' }}><span class="form-check-label">{{ __('Add a followup to the ticket when a work item is created or linked', 'azuredevops') }}</span></label>
            <label class="form-check ms-4"><input class="form-check-input" type="checkbox" name="creation_followup_private" value="1" {{ settings.creation_followup_private == '1' ? 'checked' }}><span class="form-check-label">{{ __('Private followup', 'azuredevops') }}</span></label>
            <label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="notify_requester" value="1" {{ settings.notify_requester == '1' ? 'checked' }}><span class="form-check-label">{{ __('When a work item is created, add a public followup (the technician can change this for each work item)', 'azuredevops') }}</span></label>
            <div class="ms-4 mb-2">
                <textarea name="notify_requester_text" class="form-control" rows="2" aria-label="{{ __('Message to the requester', 'azuredevops') }}" placeholder="{{ default_notice_creation }}">{{ settings.notify_requester_text }}</textarea>
                <div class="form-text">{{ __('Message to the requester', 'azuredevops') }} – {{ __('Plain text. Empty = default message.', 'azuredevops') }}</div>
            </div>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="upload_attachments" value="1" {{ settings.upload_attachments == '1' ? 'checked' }}><span class="form-check-label">{{ __('Copy the ticket attachments and images to Azure DevOps', 'azuredevops') }}</span></label>
            <div class="mt-2" style="max-width: 16rem">
                <label class="form-label">{{ __('Maximum attachment size (MB)', 'azuredevops') }}</label>
                <input type="number" min="1" name="max_attachment_mb" class="form-control" value="{{ settings.max_attachment_mb }}">
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('When a work item is done on Azure DevOps', 'azuredevops') }}</h3></div>
        <div class="card-body">
            <p class="text-muted">{{ __('A work item is "done" when its state belongs to a category chosen in its project (Completed by default). Epics and Features (the "followup only" types of the project) only add a private followup. For the other work items, the actions concerning the requester wait until every work item of the ticket is done.', 'azuredevops') }}</p>
            <h4 class="mb-2">{{ __('For technicians', 'azuredevops') }}</h4>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="close_followup" value="1" {{ settings.close_followup == '1' ? 'checked' }}><span class="form-check-label">{{ __('Add a followup with the Azure DevOps details (state, who, when)', 'azuredevops') }}</span></label>
            <label class="form-check ms-4 mb-3"><input class="form-check-input" type="checkbox" name="close_followup_private" value="1" {{ settings.close_followup_private == '1' ? 'checked' }}><span class="form-check-label">{{ __('Private followup', 'azuredevops') }}</span></label>

            <h4 class="mb-2">{{ __('For the requester', 'azuredevops') }}</h4>
            <p class="text-muted">{{ __('Requesters, who are often not technicians, never see the Azure DevOps tab. These neutral public messages tell them that their request was forwarded and completed, without any Azure DevOps detail (project, developer, link). GLPI notifications apply to public followups.', 'azuredevops') }}</p>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="none" {{ close_mode == 'none' ? 'checked' }}><span class="form-check-label">{{ __('Nothing', 'azuredevops') }}</span></label>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="followup" {{ close_mode == 'followup' ? 'checked' }}><span class="form-check-label">{{ __('A public followup with the message below', 'azuredevops') }}</span></label>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="solve" {{ close_mode == 'solve' ? 'checked' }}><span class="form-check-label">{{ __('The ticket is solved, with the message below as the solution (notifications and automatic actions apply)', 'azuredevops') }}</span></label>
            <div class="mt-2">
                <label class="form-label">{{ __('Message to the requester', 'azuredevops') }}</label>
                <textarea name="notify_requester_close_text" class="form-control" rows="2" placeholder="{{ default_notice_close }}">{{ settings.notify_requester_close_text }}</textarea>
                <div class="form-text">{{ __('Plain text. Empty = default message.', 'azuredevops') }}</div>
            </div>
            <div class="mt-2">
                <label class="form-label">{{ __('Solution type (when the ticket is solved)', 'azuredevops') }}</label>
                <select name="solutiontypes_id" class="form-select">
                    <option value="0">—</option>
                    {% for id, name in solution_types %}<option value="{{ id }}" {{ settings.solutiontypes_id == id ? 'selected' }}>{{ name }}</option>{% endfor %}
                </select>
            </div>
            <details class="mt-2" {{ settings.solution_template ? 'open' }}>
                <summary class="text-muted">{{ __('Advanced: custom solution text', 'azuredevops') }}</summary>
                <textarea name="solution_template" class="form-control mt-2" rows="3">{{ settings.solution_template }}</textarea>
                <div class="form-text">{{ __('Optional. Replaces the message above as the text of the solution (HTML allowed). Placeholders: {workitem}, {workitem_url}, {closed_by}, {closed_at}, {ticket_id}. They show Azure DevOps details to the requester.', 'azuredevops') }}</div>
            </details>

            <h4 class="mt-4 mb-2">{{ __('Author', 'azuredevops') }}</h4>
            <label class="form-label">{{ __('Author of the automatic followups and solutions', 'azuredevops') }}</label>
            <select name="actor_users_id" class="form-select">
                <option value="0">{{ __('The user who created the work item', 'azuredevops') }}</option>
                {% for id, name in users %}<option value="{{ id }}" {{ settings.actor_users_id == id ? 'selected' }}>{{ name }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <details class="card mb-3" {{ (settings.api_base_url != 'https://dev.azure.com' or settings.entra_authority != 'https://login.microsoftonline.com') ? 'open' }}>
        <summary class="card-header"><h3 class="card-title">{{ __('Advanced', 'azuredevops') }}</h3></summary>
        <div class="card-body">
            <label class="form-label">{{ __('Azure DevOps base URL', 'azuredevops') }}</label>
            <input type="url" name="api_base_url" class="form-control" value="{{ settings.api_base_url }}" placeholder="https://dev.azure.com">
            <div class="form-text">{{ __('Leave https://dev.azure.com for Azure DevOps Services.', 'azuredevops') }}</div>
            <label class="form-label mt-3">{{ __('Microsoft Entra sign-in address', 'azuredevops') }}</label>
            <input type="url" name="entra_authority" class="form-control" value="{{ settings.entra_authority }}" placeholder="https://login.microsoftonline.com">
            <div class="form-text">{{ __('Where the Entra applications of the projects sign in. Leave https://login.microsoftonline.com except for a sovereign cloud.', 'azuredevops') }}</div>
        </div>
    </details>

    <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
</form>

<form method="post" action="{{ rights_url }}" class="mt-4">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('Rights by profile', 'azuredevops') }}</h3></div>
        <div class="card-body">
            <p class="text-muted">{{ __('Rights are cumulative: "Read" is required for the others. The same rights can be edited in the "Azure DevOps" tab of each profile (Administration > Profiles). Self-service profiles cannot use the plugin. On top of these rights, a technician only works with the projects he is allowed to use (see each project).', 'azuredevops') }}</p>
            <div class="table-responsive">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>{{ __('Profile', 'azuredevops') }}</th>
                            {% for value, label in right_labels %}<th class="text-center">{{ label }}</th>{% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                    {% for profile in profiles %}
                        <tr>
                            <td>{{ profile.name }}<input type="hidden" name="profiles[]" value="{{ profile.id }}"></td>
                            {% for value, label in right_labels %}
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" name="rights[{{ profile.id }}][]" value="{{ value }}"
                                           {{ (profile.value b-and value) ? 'checked' }} {{ can_edit_rights ? '' : 'disabled' }}
                                           aria-label="{{ profile.name }} – {{ label }}">
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if not can_edit_rights %}
                <div class="text-muted small">{{ __('You need the update right on profiles to change these rights.', 'azuredevops') }}</div>
            {% endif %}
        </div>
        {% if can_edit_rights %}
            <div class="card-footer"><button type="submit" class="btn btn-primary">{{ __('Save the rights', 'azuredevops') }}</button></div>
        {% endif %}
    </div>
</form>
{% endblock %}
