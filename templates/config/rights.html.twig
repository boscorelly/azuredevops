<div class="m-3">
<form method="post" action="{{ rights_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('Rights by profile', 'azuredevops') }}</h3></div>
        <div class="card-body">
            <p class="text-muted">{{ __('Rights are cumulative: "Read" is required for the others. The same rights can be edited in the "Azure DevOps" tab of each profile (Administration > Profiles). Self-service profiles cannot use the plugin. On top of these rights, a technician only works with the projects he is allowed to use (see each project).', 'azuredevops') }}</p>
            <div class="table-responsive">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>{{ __('Profile', 'azuredevops') }}</th>
                            {% for value, label in right_labels %}<th class="text-center">{{ label }}</th>{% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                    {% for profile in profiles %}
                        <tr {{ profile.central ? '' : 'class="text-muted"' }}>
                            <td>
                                {{ profile.name }}
                                {% if profile.central %}<input type="hidden" name="profiles[]" value="{{ profile.id }}">{% else %}<span class="badge bg-secondary-lt ms-1">{{ profile.interface_label }}</span>{% endif %}
                            </td>
                            {% for value, label in right_labels %}
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" name="rights[{{ profile.id }}][]" value="{{ value }}"
                                           {{ (profile.central and (profile.value b-and value)) ? 'checked' }} {{ (can_edit_rights and profile.central) ? '' : 'disabled' }}
                                           aria-label="{{ profile.name }} – {{ label }}">
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if profiles|filter(p => not p.central)|length > 0 %}
                <div class="text-muted small mb-2"><i class="ti ti-info-circle"></i> {{ __('Profiles that do not use the standard interface (for example the simplified interface of a new profile) cannot use the plugin: they are listed for information, without rights. To give one of them rights, set its interface to the standard one in Administration > Profiles.', 'azuredevops') }}</div>
            {% endif %}
            {% if not can_edit_rights %}
                <div class="text-muted small">{{ __('You need the update right on profiles to change these rights.', 'azuredevops') }}</div>
            {% endif %}
        </div>
        {% if can_edit_rights %}
            <div class="card-footer"><button type="submit" class="btn btn-primary">{{ __('Save the rights', 'azuredevops') }}</button></div>
        {% endif %}
    </div>
</form>
</div>
