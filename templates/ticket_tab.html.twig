<div class="card m-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-brand-azure me-2"></i>{{ __('Azure DevOps', 'azuredevops') }}</h3>
    </div>

    {% if links is empty %}
        <div class="card-body text-muted">{{ __('No Azure DevOps work item is linked to this ticket.', 'azuredevops') }}</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ __('Work item', 'azuredevops') }}</th>
                        <th>{{ __('Status', 'azuredevops') }}</th>
                        <th>{{ __('Last check', 'azuredevops') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for link in links %}
                    <tr>
                        <td>
                            {% if link.chain is not empty %}
                                <div class="text-muted small mb-1">
                                    {% for c in link.chain %}
                                        {% if c.url starts with 'http://' or c.url starts with 'https://' %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.type }} #{{ c.id }} {{ c.title }}</a>{% else %}{{ c.type }} #{{ c.id }} {{ c.title }}{% endif %}
                                        <i class="ti ti-chevron-right"></i>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if link.workitem_type %}<span class="badge bg-secondary-lt me-1">{{ link.workitem_type }}</span>{% endif %}
                            {% if link.url starts with 'http://' or link.url starts with 'https://' %}
                                <a href="{{ link.url }}" target="_blank" rel="noopener">#{{ link.workitem_id }}</a>
                            {% else %}
                                #{{ link.workitem_id }}
                            {% endif %}
                            <span class="text-muted small ms-1">{{ link.project_name }}</span>
                            <div class="text-muted small">{{ link.title }}</div>
                        </td>
                        <td>
                            {% set badge = {'opened': 'bg-green-lt', 'closed': 'bg-blue-lt', 'missing': 'bg-red-lt', 'moved': 'bg-orange-lt', 'removed': 'bg-orange-lt'}[link.state] ?? 'bg-secondary-lt' %}
                            <span class="badge {{ badge }}">{{ link.state_label }}</span>
                            {% if link.ado_state %}<div class="text-muted small">{{ link.ado_state }}</div>{% endif %}
                            {% if link.state == 'closed' and link.date_closed %}
                                <div class="text-muted small">{{ link.date_closed }}{% if link.closed_by %} – {{ link.closed_by }}{% endif %}</div>
                            {% endif %}
                            {% if link.last_error %}
                                <div class="text-danger small">{{ link.last_error }}</div>
                            {% endif %}
                        </td>
                        <td class="text-muted small">{{ link.date_last_check }}</td>
                        <td class="text-end">
                            {% if can_update and link.state == 'opened' %}
                                <form method="post" action="{{ base }}/Link/{{ link.id }}/Refresh" class="d-inline">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="ti ti-refresh"></i> {{ __('Refresh', 'azuredevops') }}</button>
                                </form>
                            {% endif %}
                            {% if can_delete %}
                                <form method="post" action="{{ base }}/Link/{{ link.id }}/Unlink" class="d-inline"
                                      onsubmit="return confirm('{{ __('Stop following this work item? It will not be changed on Azure DevOps.', 'azuredevops')|e('js') }}');">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="ti ti-unlink"></i> {{ __('Unlink', 'azuredevops') }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if hidden_count > 0 %}
        <div class="card-footer text-muted small">
            <i class="ti ti-lock"></i> {{ _n('%d other work item is linked to a project you cannot use.', '%d other work items are linked to projects you cannot use.', hidden_count, 'azuredevops')|format(hidden_count) }}
        </div>
    {% endif %}

    {% if locked %}
        <div class="card-footer text-muted"><i class="ti ti-lock"></i> {{ __('The ticket is solved or closed: no action is possible on its Azure DevOps work items.', 'azuredevops') }}</div>
    {% elseif not any_project %}
        <div class="card-footer text-muted">
            {{ __('The plugin is not configured yet.', 'azuredevops') }}
            {% if can_config %}<a href="{{ base }}/Config">{{ __('Configure it', 'azuredevops') }}</a>{% endif %}
        </div>
    {% elseif projects is empty %}
        <div class="card-footer text-muted">{{ __('No Azure DevOps project is available to you. Ask an administrator to add your group or your user to a project.', 'azuredevops') }}</div>
    {% elseif can_create %}
        {% set rand = random() %}
        <form method="post" action="{{ base }}/Ticket/{{ ticket_id }}/WorkItem" class="card-footer" id="ado_create_{{ rand }}"
              data-config="{{ config|json_encode|e('html_attr') }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <h4 class="mb-2">{{ __('Create a work item', 'azuredevops') }}</h4>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="ado_cp_{{ rand }}">{{ __('Project', 'azuredevops') }}</label>
                    <select id="ado_cp_{{ rand }}" name="project_id" class="form-select" required>
                        {% for p in projects %}{% if p.ready %}
                            <option value="{{ p.id }}" data-parents="{{ p.has_parents ? 1 : 0 }}">{{ p.name }}</option>
                        {% endif %}{% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ado_wtype_{{ rand }}">{{ __('Type', 'azuredevops') }}</label>
                    <select id="ado_wtype_{{ rand }}" name="work_item_type" class="form-select"></select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="ado_parent_{{ rand }}">{{ __('Under (Epic, Feature…)', 'azuredevops') }}</label>
                    <select id="ado_parent_{{ rand }}" name="parent_id" class="form-select" style="width:100%"><option></option></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ado_followup_{{ rand }}">{{ __('Followup on the ticket', 'azuredevops') }}</label>
                    <select id="ado_followup_{{ rand }}" name="followup" class="form-select">
                        <option value="private" {{ default_followup == 'private' ? 'selected' }}>{{ __('Private', 'azuredevops') }}</option>
                        <option value="public" {{ default_followup == 'public' ? 'selected' }}>{{ __('Public', 'azuredevops') }}</option>
                        <option value="none" {{ default_followup == 'none' ? 'selected' }}>{{ __('None', 'azuredevops') }}</option>
                    </select>
                </div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-md-8">
                    <label class="form-label" for="ado_tags_{{ rand }}">{{ __('Additional tags', 'azuredevops') }}</label>
                    <select id="ado_tags_{{ rand }}" name="tags[]" class="form-select" multiple style="width:100%"></select>
                    <div id="ado_tags_hint_{{ rand }}" class="form-text"></div>
                </div>
            </div>
            <div id="ado_fields_title_{{ rand }}" class="mt-3 d-none"><span class="form-label">{{ __('Required by the process', 'azuredevops') }}</span></div>
            <div id="ado_fields_{{ rand }}" class="row g-2 mb-1"></div>
            <input type="hidden" name="notify_requester" value="0">
            <label class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="notify_requester" value="1" {{ default_notify ? 'checked' }}>
                <span class="form-check-label">{{ __('Inform the requester with a public followup', 'azuredevops') }}</span>
            </label>
            <div class="form-text ms-4">« {{ notice_text }} »</div>
            {% if links is not empty %}
                <label class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="allow_duplicate" value="1">
                    <span class="form-check-label">{{ __('Create another work item even if one is already open in this project', 'azuredevops') }}</span>
                </label>
            {% endif %}
            <button type="submit" class="btn btn-primary mt-3"><i class="ti ti-brand-azure"></i> {{ __('Create the work item', 'azuredevops') }}</button>
        </form>

        <form method="post" action="{{ base }}/Ticket/{{ ticket_id }}/WorkItem/Link" class="card-footer border-top">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <h4 class="mb-2">{{ __('Link an existing work item', 'azuredevops') }}</h4>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="ado_lp_{{ rand }}">{{ __('Project', 'azuredevops') }}</label>
                    <select id="ado_lp_{{ rand }}" name="project_id" class="form-select" required>
                        {% for p in projects %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="ado_item_{{ rand }}">{{ __('Work item (title or number)', 'azuredevops') }}</label>
                    <select id="ado_item_{{ rand }}" name="workitem_id" class="form-select" required style="width:100%"><option></option></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ado_lfollowup_{{ rand }}">{{ __('Followup on the ticket', 'azuredevops') }}</label>
                    <select id="ado_lfollowup_{{ rand }}" name="followup" class="form-select">
                        <option value="private" {{ default_followup == 'private' ? 'selected' }}>{{ __('Private', 'azuredevops') }}</option>
                        <option value="public" {{ default_followup == 'public' ? 'selected' }}>{{ __('Public', 'azuredevops') }}</option>
                        <option value="none" {{ default_followup == 'none' ? 'selected' }}>{{ __('None', 'azuredevops') }}</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="ti ti-link"></i> {{ __('Link', 'azuredevops') }}</button>
                </div>
            </div>
        </form>

        <script>
            $(function () {
                var base = {{ base|json_encode|raw }};
                var $cp = $('#ado_cp_{{ rand }}'), $parent = $('#ado_parent_{{ rand }}');
                var $lp = $('#ado_lp_{{ rand }}'), $item = $('#ado_item_{{ rand }}');

                function finder($project, scope, $el, placeholder, allowClear) {
                    $el.select2({
                        width: '100%', allowClear: allowClear, placeholder: placeholder,
                        ajax: {
                            url: function () { return base + '/Projects/' + $project.val() + '/Search'; },
                            dataType: 'json', delay: 300,
                            data: function (params) { return {term: params.term || '', scope: scope}; },
                            // An Azure DevOps error is shown in the list (it is also in files/_log/azuredevops.log)
                            transport: function (params, success, failure) {
                                var request = $.ajax(params);
                                request.then(success);
                                request.fail(function (xhr) {
                                    var message = xhr.responseJSON && xhr.responseJSON.error;
                                    if (message) { success({results: [{id: '', text: '\u26A0 ' + message, disabled: true}]}); } else { failure(); }
                                });
                                return request;
                            }
                        }
                    });
                }
                finder($cp, 'parents', $parent, {{ __('No parent', 'azuredevops')|json_encode|raw }}, true);
                finder($lp, 'items', $item, {{ __('Search a work item…', 'azuredevops')|json_encode|raw }}, false);

                // What the form needs for each project: its types, the default one, and the fields the process requires per type
                var config = {};
                try { config = JSON.parse($('#ado_create_{{ rand }}').attr('data-config') || '{}'); } catch (e) { config = {}; }
                var $type = $('#ado_wtype_{{ rand }}');

                function renderFields() {
                    var pid = $cp.val(), type = $type.val(), project = config[pid] || {}, list = (project.fields || {})[type], $box = $('#ado_fields_{{ rand }}').empty();
                    if (list === null || list === undefined && type) {
                        // The fields of this type were not read from Azure DevOps yet: ask for them now
                        $('#ado_fields_title_{{ rand }}').removeClass('d-none');
                        $box.append($('<div class="col-12 text-muted small"></div>').text({{ __('Reading the fields of this type from Azure DevOps…', 'azuredevops')|json_encode|raw }}));
                        $.getJSON(base + '/Projects/' + pid + '/TypeFields', {type: type, ticket: {{ ticket_id }}}).done(function (data) {
                            project.fields = project.fields || {};
                            project.fields[type] = data.fields || [];
                            if ($cp.val() === pid && $type.val() === type) { renderFields(); }
                        }).fail(function (xhr) {
                            if ($cp.val() !== pid || $type.val() !== type) { return; }
                            var message = (xhr.responseJSON && xhr.responseJSON.error) || {{ __('The fields of this type could not be read.', 'azuredevops')|json_encode|raw }};
                            $box.empty().append($('<div class="col-12 text-danger small"></div>').text('\u26A0 ' + message));
                        });
                        return;
                    }
                    list = list || [];
                    $.each(list, function (i, f) {
                        var id = 'ado_f_{{ rand }}_' + i, name = 'fields[' + f.ref + ']', $input;
                        if (f.allowed && f.allowed.length) {
                            $input = $('<select class="form-select"></select>').attr({id: id, name: name});
                            $input.append($('<option value=""></option>').text('\u2014'));
                            $.each(f.allowed, function (j, v) { $input.append($('<option></option>').val(v).text(v).prop('selected', v === f.value)); });
                        } else {
                            $input = $('<input type="text" class="form-control">').attr({id: id, name: name}).val(f.value);
                        }
                        $box.append($('<div class="col-md-3"></div>').append($('<label class="form-label"></label>').attr('for', id).text(f.name)).append($input));
                    });
                    $('#ado_fields_title_{{ rand }}').toggleClass('d-none', list.length === 0);
                }

                // The types of the chosen project, the default one selected
                function renderTypes() {
                    var project = config[$cp.val()] || {types: [], 'default': ''};
                    $type.empty();
                    $.each(project.types || [], function (i, t) { $type.append($('<option></option>').val(t).text(t).prop('selected', t === project['default'])); });
                }

                // Existing tags of the project in Azure DevOps; a new one can be typed unless the project only allows existing tags
                var $tags = $('#ado_tags_{{ rand }}'), $tagsHint = $('#ado_tags_hint_{{ rand }}');
                function renderTags() {
                    var project = config[$cp.val()] || {};
                    if ($tags.data('select2')) { $tags.select2('destroy'); }
                    $tags.empty();
                    $tags.select2({
                        width: '100%', tags: !project.restrict_tags, tokenSeparators: [',', ';'], placeholder: {{ __('Choose or type tags…', 'azuredevops')|json_encode|raw }},
                        ajax: {
                            url: function () { return base + '/Projects/' + $cp.val() + '/Tags'; },
                            dataType: 'json', delay: 300,
                            data: function (params) { return {term: params.term || ''}; },
                            transport: function (params, success, failure) {
                                var request = $.ajax(params);
                                request.then(success);
                                request.fail(function (xhr) {
                                    var message = xhr.responseJSON && xhr.responseJSON.error;
                                    if (message) { success({results: [{id: '', text: '\u26A0 ' + message, disabled: true}]}); } else { failure(); }
                                });
                                return request;
                            }
                        }
                    });
                    var always = project.default_tags || [];
                    $tagsHint.text(always.length ? {{ __('Always added:', 'azuredevops')|json_encode|raw }} + ' ' + always.join(', ') : '');
                }

                function syncCreate() {
                    var $o = $cp.find('option:selected');
                    renderTags();
                    $parent.val(null).trigger('change').prop('disabled', $o.data('parents') != 1);
                    renderTypes();
                    renderFields();
                }
                $type.on('change', renderFields);
                $cp.on('change', syncCreate);
                $lp.on('change', function () { $item.val(null).trigger('change'); });
                syncCreate();
            });
        </script>
    {% endif %}
</div>
